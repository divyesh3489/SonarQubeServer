# Shared by get-cert.sh and renew-cert.sh. Certbot runs from Docker so the host's certbot
# (used for the existing domain) is never upgraded or touched, and it keeps its state in a
# separate directory so the host certbot never tries to renew the IP certificate.
CERTBOT_IMAGE=certbot/certbot:v5.8.0
CERT_DIR=/etc/letsencrypt-sonarqube
WEBROOT=/var/www/certbot
