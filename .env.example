# Copy to .env and change the password before starting.
# Host port SonarQube is published on. Must not be used by the existing project.
SONAR_PORT=9000

# EC2 public IP (use an Elastic IP). Only requests to this IP reach SonarQube.
# setup-host.sh fills this in automatically.
PUBLIC_IP=

POSTGRES_USER=sonar
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=sonarqube
